# Copy to .env. Never commit .env.
#
# ADR-003 §4 restricts this engine to fixture data. No customer document may be
# ingested until L1 (lawful third-party processing) is answered.

# Application connection. Non-superuser, non-owner, so row-level security binds.
REEF_DATABASE_URL=postgresql+psycopg://reef_app:reef_app@localhost:5432/reef

# Migration connection. Owner, runs Alembic. Not used at request time.
REEF_MIGRATION_DATABASE_URL=postgresql+psycopg://reef:reef@localhost:5432/reef

# Object storage. `filesystem` needs no daemon and is the local default.
# `s3` is for deployed environments; set the credentials below when you switch.
REEF_STORAGE_BACKEND=filesystem
REEF_STORAGE_ROOT=.reef-storage
# REEF_S3_ENDPOINT_URL=
# REEF_S3_ACCESS_KEY=
# REEF_S3_SECRET_KEY=
REEF_ORIGINALS_BUCKET=reef-originals
REEF_RENDERS_BUCKET=reef-renders

# Intake limits. Uploads are the attack surface.
REEF_MAX_FILE_BYTES=524288000
REEF_MAX_ARCHIVE_ENTRIES=20000
REEF_MAX_ARCHIVE_EXPANDED_BYTES=5368709120
REEF_MAX_ARCHIVE_DEPTH=3

# Embedding. `local` needs no API key and no network, which is the default because
# ADR-003 forbids sending document content anywhere during engine work.
REEF_EMBEDDING_PROVIDER=local
REEF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
REEF_EMBEDDING_DIM=384

# OCR. `none` means scanned pages are registered as unprocessable rather than
# silently producing empty text.
REEF_OCR_PROVIDER=none

REEF_LOG_LEVEL=INFO

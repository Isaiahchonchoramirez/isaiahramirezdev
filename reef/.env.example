# Copy to .env. Never commit .env.
#
# ADR-003 §4 restricts this engine to fixture data. No customer document may be
# ingested until L1 (lawful third-party processing) is answered.
#
# EVERY VALUE HERE MATCHES THE CODE DEFAULT IN src/reef/config.py, and a test
# (tests/test_embedding_contract.py) fails the build if the two ever diverge.
# They diverged silently once: this file pinned all-MiniLM-L6-v2 while the code
# default was bge-small-en-v1.5, and a benchmark was published attributing its
# numbers to a model it had never run. Run `reef config` to see the resolved
# values and where each one came from.
#
# A file named `.env` overrides these defaults invisibly. If you create one,
# `reef config` marks every overridden value in yellow — check it before
# recording any measurement.

# Application connection. Non-superuser, non-owner, so row-level security binds.
REEF_DATABASE_URL=postgresql+psycopg://reef_app:reef_app@localhost:5432/reef

# Migration connection. Owner, runs Alembic. Not used at request time.
REEF_MIGRATION_DATABASE_URL=postgresql+psycopg://reef:reef@localhost:5432/reef

# Object storage. `filesystem` needs no daemon and is the local default.
REEF_STORAGE_BACKEND=filesystem
REEF_STORAGE_ROOT=.reef-storage
# REEF_S3_ENDPOINT_URL=
# REEF_S3_ACCESS_KEY=
# REEF_S3_SECRET_KEY=
REEF_ORIGINALS_BUCKET=reef-originals
REEF_RENDERS_BUCKET=reef-renders

# Intake limits. Uploads are the attack surface.
REEF_MAX_FILE_BYTES=524288000
REEF_MAX_ARCHIVE_ENTRIES=20000
REEF_MAX_ARCHIVE_EXPANDED_BYTES=5368709120
REEF_MAX_ARCHIVE_DEPTH=3

# Embedding. `local` needs no API key and no network at query time, which is the
# default because ADR-003 forbids sending document content anywhere.
#
# The model is canonical, not a preference: its 512-token window covers the
# 500-token chunk ceiling. MiniLM's 256-token window truncates 15 of 862 chunks
# on the Ridgeline corpus and discards 14.2% of indexed text, while the chunk
# still claims provenance over the text that never reached the model.
#
# Changing the model invalidates every stored vector and every calibration keyed
# to the old one. Re-index and re-calibrate; search refuses until you do.
REEF_EMBEDDING_PROVIDER=local
REEF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
REEF_EMBEDDING_DIM=384
REEF_EMBEDDING_MAX_TOKENS=512

# Whether search may run against a model with no calibrated abstention floor.
# Off by default. When on, results are labelled `uncalibrated` and their
# abstention behaviour must not be reported as a passing metric.
REEF_ALLOW_UNCALIBRATED_SEARCH=false

# Chunking. Sized to the encoder window above, never independently.
REEF_CHUNK_TARGET_TOKENS=420
REEF_CHUNK_MAX_TOKENS=500

# OCR. `none` means scanned pages are registered as unprocessable rather than
# silently producing empty text.
REEF_OCR_PROVIDER=none

REEF_LOG_LEVEL=INFO
